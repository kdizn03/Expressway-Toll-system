generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RateStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  EXPIRED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String                   @id @default(cuid())
  fullName            String
  email               String                   @unique
  passwordHash        String?
  emailVerifiedAt     DateTime?
  role                UserRole                 @default(USER)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sessions            AuthSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]
  preferences         UserPreference?
  vehicles            VehicleProfile[]
  savedRoutes         SavedRoute[]
  tripHistory         TripHistory[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  defaultVehicleClass    String?
  fuelEfficiencyKmPerL   Float?
  fuelPricePerL          Float?
  emailTripUpdates       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VehicleProfile {
  id            String   @id @default(cuid())
  userId        String
  name          String
  vehicleClass  String
  fuelEfficiencyKmPerL Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
  @@index([userId])
}

model SavedRoute {
  id          String   @id @default(cuid())
  userId      String
  name        String
  origin      String
  destination String
  vehicleClass String?
  routeData   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model TripHistory {
  id          String   @id @default(cuid())
  userId      String
  origin      String
  destination String
  vehicleClass String?
  routeData   Json?
  traveledAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, traveledAt])
}

model Expressway {
  id String @id @default(cuid())
  name String @unique
  abbreviation String @unique
  operator String?
  region String?
  status String @default("operational")
  rfidSystem String?
  tollSystemType String?
  pricingModel String @default("closed_matrix")
  geometry Json?
  sourceInfo Json?
  notes String?
  lastVerifiedAt DateTime?
  plazas TollPlaza[]
  versions RateVersion[]
  restrictions VehicleRestriction[]
  createdAt DateTime @default(now())
}

model TollPlaza {
  id String @id @default(cuid())
  expresswayId String
  name String
  latitude Float
  longitude Float
  direction String?
  externalId String?
  sequence Int?
  aliases Json?
  /// ENTRY_EXIT, ENTRY, EXIT, BARRIER, or null when not yet determined.
  plazaType String?
  kmPost Float?
  /// VERIFIED_GEODATA, UNVERIFIED, SUSPECT, or NEEDS_REVIEW. See lib/toll-data/statuses.ts.
  verificationStatus String @default("UNVERIFIED")
  verificationSource String?
  verifiedAt DateTime?
  /// Obsolete or duplicate locators are deactivated, never deleted, so historical rates stay interpretable.
  active Boolean @default(true)
  notes String?
  expressway Expressway @relation(fields: [expresswayId], references: [id])
  entryRates TollRate[] @relation("RateEntryPlaza")
  exitRates TollRate[] @relation("RateExitPlaza")
  @@unique([expresswayId, name])
  @@index([expresswayId])
}

model VehicleClass {
  id String @id @default(cuid())
  code String @unique
  displayName String
  description String?
  restrictions VehicleRestriction[]
  rates TollRate[]
}

model VehicleRestriction {
  id String @id @default(cuid())
  expresswayId String
  vehicleClassId String
  allowed Boolean @default(true)
  notes String?
  effectiveFrom DateTime
  effectiveTo DateTime?
  source String?
  expressway Expressway @relation(fields: [expresswayId], references: [id])
  vehicleClass VehicleClass @relation(fields: [vehicleClassId], references: [id])
  @@index([expresswayId, vehicleClassId, effectiveFrom])
}

model RateSource {
  id String @id @default(cuid())
  name String
  officialUrl String
  sourceType String
  expresswayId String?
  enabled Boolean @default(true)
  lastCheckedAt DateTime?
  lastSuccessfulAt DateTime?
  contentHash String?
  notes String?
  /// Monitoring: parser id (see lib/toll-data/parsers.ts); null means change detection only.
  monitorEnabled Boolean @default(false)
  parser String?
  checkIntervalHours Int @default(24)
  nextCheckAt DateTime?
  etag String?
  lastModified String?
  consecutiveFailures Int @default(0)
  lastError String?
  /// Only honoured for authoritative sources when the global auto-publish policy is also enabled.
  autoPublish Boolean @default(false)
  versions RateVersion[]
  snapshots SourceSnapshot[]
  matrixImports MatrixImport[]
  checks SourceCheck[]
}

model RateVersion {
  id String @id @default(cuid())
  expresswayId String
  sourceId String
  versionNumber Int
  retrievedAt DateTime @default(now())
  verifiedAt DateTime?
  effectiveFrom DateTime
  effectiveTo DateTime?
  status RateStatus @default(DRAFT)
  notes String?
  createdBy String?
  approvedBy String?
  verificationStatus String?
  sourceReference String?
  createdAt DateTime @default(now())
  expressway Expressway @relation(fields: [expresswayId], references: [id])
  source RateSource @relation(fields: [sourceId], references: [id])
  rates TollRate[]
  @@unique([expresswayId, versionNumber])
  @@index([expresswayId, status, effectiveFrom, effectiveTo])
}

model TollRate {
  id String @id @default(cuid())
  rateVersionId String
  entryPlazaId String
  exitPlazaId String
  vehicleClassId String
  tollCentavos Int
  vatIncluded Boolean @default(true)
  rateVersion RateVersion @relation(fields: [rateVersionId], references: [id])
  vehicleClass VehicleClass @relation(fields: [vehicleClassId], references: [id])
  entryPlaza TollPlaza @relation("RateEntryPlaza", fields: [entryPlazaId], references: [id])
  exitPlaza TollPlaza @relation("RateExitPlaza", fields: [exitPlazaId], references: [id])
  @@unique([rateVersionId, entryPlazaId, exitPlazaId, vehicleClassId])
  @@index([entryPlazaId, exitPlazaId, vehicleClassId])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String
  oldValue Json?
  newValue Json?
  reason String?
  createdAt DateTime @default(now())
}

model SourceSnapshot {
  id String @id @default(cuid())
  sourceId String
  contentHash String
  retrievedAt DateTime @default(now())
  requiresManualReview Boolean @default(false)
  /// The retrieved document (or a reproducible reference to it) so reviewers can inspect the original.
  sourceUrl String?
  contentType String?
  byteLength Int?
  content String?
  source RateSource @relation(fields: [sourceId], references: [id])
  imports MatrixImport[]
  @@unique([sourceId, contentHash])
}

model MatrixImport {
  id String @id @default(cuid())
  sourceId String
  sourceSnapshotId String
  contentHash String
  sourceUrl String
  retrievedAt DateTime @default(now())
  reportedUpdatedAt DateTime?
  status RateStatus @default(PENDING_REVIEW)
  rowCount Int
  notes String?
  /// MatrixImport status meaning: PENDING_REVIEW = proposed, not used; PUBLISHED = approved for display
  /// (as an estimate unless the source is authoritative); EXPIRED = superseded; REJECTED = declined.
  verificationStatus String @default("THIRD_PARTY_ESTIMATE")
  effectiveFrom DateTime?
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  source RateSource @relation(fields: [sourceId], references: [id])
  sourceSnapshot SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id])
  rows MatrixImportRow[]
  changeReport RateChangeReport?
  @@unique([sourceId, contentHash])
  @@index([sourceId, status, retrievedAt])
}

model MatrixImportRow {
  id String @id @default(cuid())
  matrixImportId String
  entryExpresswayCode String
  exitExpresswayCode String
  entryName String
  exitName String
  vehicleClassCode String
  tollCentavos Int
  reversible Boolean @default(false)
  /// Per-row override, e.g. INDEPENDENTLY_VERIFIED (matches a TRB announcement) or SUPERSEDED (a newer approved rate exists).
  verificationStatus String?
  verificationNote String?
  matrixImport MatrixImport @relation(fields: [matrixImportId], references: [id], onDelete: Cascade)
  @@unique([matrixImportId, entryExpresswayCode, exitExpresswayCode, entryName, exitName, vehicleClassCode])
  @@index([entryExpresswayCode, exitExpresswayCode, entryName, exitName])
}

/// One monitoring attempt for a source (scheduled, weekly, or manual).
model SourceCheck {
  id String @id @default(cuid())
  sourceId String
  trigger String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  /// UNCHANGED, CHANGED, FAILED, or SKIPPED
  outcome String
  httpStatus Int?
  message String?
  snapshotId String?
  matrixImportId String?
  source RateSource @relation(fields: [sourceId], references: [id])
  @@index([sourceId, startedAt])
}

/// Structured difference between a proposed matrix import and the rates currently in use.
model RateChangeReport {
  id String @id @default(cuid())
  matrixImportId String @unique
  baselineImportId String?
  summary Json
  details Json
  createdAt DateTime @default(now())
  matrixImport MatrixImport @relation(fields: [matrixImportId], references: [id], onDelete: Cascade)
}

/// Global toll-data settings (key/value), e.g. the auto-publish policy.
model TollDataSetting {
  key String @id
  value Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}
