DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luzon_tollmap?schema=public"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_public_mapbox_token"
MAPBOX_ACCESS_TOKEN="pk_or_sk_server_token"
# Keep Mapbox as the fallback. Set both providers to google only after enabling
# Maps JavaScript API, Geocoding API, and Routes API for separately restricted keys.
ROUTING_PROVIDER="mapbox"
NEXT_PUBLIC_MAP_PROVIDER="mapbox"
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""
CRON_SECRET="generate-a-long-random-secret"
SYNC_SCHEDULE="0 2 * * *"

# Authentication: use your deployed public URL outside local development.
AUTH_BASE_URL="http://localhost:3000"
# Local-only email delivery writes verification/reset links to the server console.
# Never use this mode in production.
AUTH_EMAIL_DELIVERY="console"
# Gmail SMTP: enable 2-Step Verification, create a Google App Password, then
# change AUTH_EMAIL_DELIVERY to "gmail". Never use your normal Gmail password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Production email delivery uses the Resend-compatible API below.
EMAIL_FROM=""
EMAIL_API_KEY=""
EMAIL_API_URL="https://api.resend.com/emails"
# Optional Google sign-in. Leave all three blank to hide Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
